{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emorva",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}